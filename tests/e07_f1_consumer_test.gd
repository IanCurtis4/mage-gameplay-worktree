	check(flight.contact(5.0,candidates)["ok"],"flight advances before wall exists")
	check(world.insert_obstacle("flight_wall",AABB(Vector3(40,0,130),Vector3(4,20,40)),world.geometry_revision)["ok"],"wall inserted after launch")
	var stopped := flight.contact(100.0,candidates)
	check(stopped["ok"] and stopped["data"]["terrain"] and stopped["data"]["actor"] == null and stopped["data"]["volume_id"] == "temporary/flight_wall","flight sweeps new geometry instead of stale launch revision")
	world.remove_obstacle("flight_wall",world.geometry_revision)
	check(is_equal_approx(WorldProjectileMotion.cylinder_fraction(Vector3(0,5,0),Vector3(100,5,0),Vector3(50,0,0),3.0,12.0,2.0),0.47),"independent radial root oracle")
	check(WorldProjectileMotion.cylinder_fraction(Vector3(0,30,0),Vector3(100,30,0),Vector3(50,0,0),3.0,12.0,2.0) < 0.0,"radial overlap alone cannot hit another height")
	var incompatible := CombatActor.new(); root.add_child(incompatible); owned.append(incompatible)
	incompatible.setup("legacy",Color.WHITE,lower.stat_breakdown)
	check(not flight.validate_targets([incompatible])["ok"],"mixed legacy target rejected explicitly")
	var rain := ArrowRain.new(); root.add_child(rain); owned.append(rain)
	rain.configure(Vector2(9000,9000),DamageRequest.new(),candidates); rain.set_process(false)
	check(rain.bind_world_area(world,origin,profile,world.geometry_revision)["ok"],"rain captures explicit support anchor")
	rain.hit.connect(func(_request: DamageRequest,victim: CombatActor) -> void: hits.append(victim.get_instance_id()))
	hits.clear(); rain._process(1.0)
	check(hits == [lower.get_instance_id(),lower.get_instance_id(),lower.get_instance_id()],"three scheduled ground volleys sample lower surface without bleeding onto bridge")
	var trap := ExplosiveTrap.new(); root.add_child(trap); owned.append(trap)
