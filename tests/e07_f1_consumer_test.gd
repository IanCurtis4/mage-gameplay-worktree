		check(projectile.bind_world_flight(world,origin,Vector3(0,5,0),Vector3.RIGHT,{"radius":1.0,"height":2.0},world.geometry_revision)["ok"],"real projectile binds copied world trajectory")
		projectile.hit.connect(func(_request: DamageRequest,victim: CombatActor) -> void: hits.append(victim.get_instance_id()))
		hits.clear()
