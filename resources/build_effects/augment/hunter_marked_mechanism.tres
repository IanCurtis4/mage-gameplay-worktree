[resource]
script = ExtResource("2_ccuch")
id = &"hunter_marked_mechanism"
display_name = "Armadilhas da Marca"
flavor_text = "A Marca capturada define quem pode acionar Congelante, Piche ou Espinhos; depois do disparo, a área segue suas regras próprias."
description = "Congelante, Piche e Espinhos só são disparadas pelo alvo da Marca capturada na colocação. Sem Marca viva, não há custo nem colocação. Área e vítimas seguem as regras da armadilha. Requer Marca e uma dessas armadilhas aprendidas. Requer rank 1 na habilidade afetada. Não combina com outra transformação do mesmo grupo.
Acumula até 1 vez(es)."
