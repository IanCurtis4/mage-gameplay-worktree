	var direct_request := DamageRequest.new(); direct_request.source_id = shield_player.get_instance_id(); direct_request.target_id = lower.get_instance_id(); direct_request.physical_damage = 5.0; direct_request.accuracy_mode = DamageRequest.AccuracyMode.GEOMETRY
	var hp_before := lower.health.current_hp
