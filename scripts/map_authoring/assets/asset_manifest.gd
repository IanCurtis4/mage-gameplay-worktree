@tool
extends RefCounted
## Checkpoint41 (F9-09/F9-11): content hashes of the editor assets that compiled
## map packages name as dependencies (textures, their import settings, shaders,
## catalogs). In the editor and in source runs the real file bytes are hashed, as
## before. An exported release does not ship the raw PNGs and rewrites the import
## files, so there the build-time manifest stands in for the bytes: an entry counts
## only if the shipped resource exists. The manifest is regenerated by
## tools/map_editor_assets/build_manifest.gd and checked by the AssetManifest stage.
const PATH := "res://data/map_authoring/asset_manifest.json"
const SCHEMA_VERSION := 1
const ROOTS := ["res://assets/art/map_authoring"]
const EXTRA := ["res://data/map_authoring/prop_catalog.json","res://data/map_authoring/border_profiles.json","res://scripts/map_authoring/terrain/terrain_material.gdshader","res://scripts/map_authoring/terrain/border_material.gdshader","res://scripts/map_authoring/terrain/water_material.gdshader"]
const MATERIAL_RECORD := "res://assets/art/map_authoring/materials_provenance.json"
const PROP_RECORD := "res://assets/art/map_authoring/props/provenance.json"

## Exported builds (export templates) read the manifest; everything else hashes
## the file itself.
static func exported() -> bool:
	return OS.has_feature("template")

## Hash for a dependency path, or "" when it is absent.
static func sha256(path: String) -> String:
	return sha256_for(path, exported())

static func sha256_for(path: String, from_manifest: bool, manifest: Dictionary = {}) -> String:
	if not from_manifest:
		return FileAccess.get_sha256(path) if FileAccess.file_exists(path) else ""
	var entries: Dictionary = manifest if not manifest.is_empty() else entries_by_path()
	if not entries.has(path): return ""
	var resource := path.trim_suffix(".import")
	if not FileAccess.file_exists(path) and not ResourceLoader.exists(resource): return ""
	return String(entries[path]["sha256"])

static func exists(path: String) -> bool:
	return not sha256(path).is_empty()

## path -> entry, from the committed manifest; {} if it is missing or malformed.
static func entries_by_path() -> Dictionary:
	if not FileAccess.file_exists(PATH): return {}
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(PATH))
	if not valid(parsed): return {}
	var result := {}
	for entry: Dictionary in parsed["entries"]: result[entry["path"]] = entry
	return result

static func valid(value: Variant) -> bool:
	if not value is Dictionary or value.size() != 2 or not value.has_all(["schema_version","entries"]) or int(value["schema_version"]) != SCHEMA_VERSION or not value["entries"] is Array: return false
	var seen := {}
	for entry: Variant in value["entries"]:
		if not entry is Dictionary or entry.size() != 5 or not entry.has_all(["path","sha256","kind","rights_basis","record"]): return false
		var path: Variant = entry["path"]
		if not path is String or not String(path).begins_with("res://") or ".." in String(path) or "\\" in String(path) or seen.has(path): return false
		if not entry["sha256"] is String or String(entry["sha256"]).length() != 64 or not String(entry["sha256"]).is_valid_hex_number(false): return false
		if entry["kind"] not in ["texture","import","shader","catalog"] or not entry["rights_basis"] is String or not entry["record"] is String: return false
		seen[path] = true
	return true

## The manifest as it should be for the files in this checkout (source runs only).
static func build() -> Dictionary:
	var paths: Array[String] = []
	for root: String in ROOTS: _collect(root, paths)
	for path: String in EXTRA:
		if FileAccess.file_exists(path): paths.append(path)
	paths.sort()
	var rights := _rights()
	var entries: Array = []
	for path: String in paths:
		var kind := "import" if path.ends_with(".import") else ("texture" if path.ends_with(".png") else ("shader" if path.ends_with(".gdshader") else "catalog"))
		var basis: Dictionary = rights.get(path.trim_suffix(".import"), {"rights_basis":"project_source","record":""})
		entries.append({"path":path,"sha256":FileAccess.get_sha256(path),"kind":kind,"rights_basis":basis["rights_basis"],"record":basis["record"]})
	return {"schema_version":SCHEMA_VERSION,"entries":entries}

static func _collect(directory: String, paths: Array[String]) -> void:
	for file: String in DirAccess.get_files_at(directory):
		if file.ends_with(".png") or file.ends_with(".png.import"): paths.append(directory.path_join(file))
	for child: String in DirAccess.get_directories_at(directory): _collect(directory.path_join(child), paths)

# Textures named in a provenance record carry its rights basis and the record path.
static func _rights() -> Dictionary:
	# Grass and earth (F2) are recorded in materials.md, not in the JSON record.
	var result := {}
	for name: String in ["grass_tile.png","earth_tile.png"]:
		result["res://assets/art/map_authoring/"+name] = {"rights_basis":"project_generated_output","record":"res://assets/art/map_authoring/materials.md"}
	for record: String in [MATERIAL_RECORD, PROP_RECORD]:
		if not FileAccess.file_exists(record): continue
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(record))
		if not parsed is Dictionary or not parsed.get("assets") is Array: continue
		for asset: Variant in parsed["assets"]:
			if asset is Dictionary and asset.get("path") is String:
				result[record.get_base_dir().path_join(asset["path"])] = {"rights_basis":String(parsed.get("rights_basis","")),"record":record}
	return result

static func encode(manifest: Dictionary) -> String:
	return JSON.stringify(manifest, "  ", false) + "\n"
