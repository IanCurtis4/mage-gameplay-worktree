	check(enemy.world_point().position.y > 0.0 and enemy.engagement_mode == &"engaged","autonomous enemy perceives and follows actual ramp route")
	check(not attacks.is_empty() and enemy.world_distance_to(player) <= 55.0,"real AI attacks only after valid 3D range/LoS")
	enemy._mob_definition.leash_radius = 100.0
	for index: int in range(300): enemy._process(0.01)
	check(enemy.world_point().position.distance_to(enemy._world_home.position) < 0.001 and enemy.engagement_mode == &"idle","leash returns through connected support to exact captured home")
	var covered_player := make_player(nav,&"swordsman",{})
	covered_player.bind_world_geometry(world,Fixture.point("bridge",Vector3(30,40,150)),profile,"upper_player"); covered_player.set_process(false)
	var under_enemy := EnemyActor.new(); root.add_child(under_enemy); owned.append(under_enemy)
	under_enemy.configure(&"chaser",nav,covered_player)
	under_enemy.bind_world_geometry(world,Fixture.point("root",Vector3(30,0,150)),profile,"lower_enemy"); under_enemy.set_process(false)
	under_enemy._mob_definition.aggro_radius = 200.0; under_enemy._mob_definition.leash_radius = 300.0
	under_enemy._process(0.1)
	check(not under_enemy.player_target_acquired and under_enemy.engagement_mode == &"idle","solid bridge prevents AI perception despite short vertical range")
	check(not covered_player.can_basic_attack(under_enemy),"player basic uses same slab occlusion authority")
	var shelter := FoliageShelter.new(); root.add_child(shelter); owned.append(shelter)
	check(shelter.configure_world(covered_player,covered_player.world_point(),profile,2.0,60.0,0.0,world.geometry_revision)["ok"],"real shelter captures upper support")
	shelter.set_process(false)
	check(covered_player.is_concealed() and not covered_player.can_be_acquired_by_world(under_enemy),"lower observer cannot reveal upper shelter through slab")
	check(covered_player.can_be_acquired_by_world(upper),"observer on same supported shelter can acquire concealed player")
	covered_player.reveal_from_offense()
	check(not covered_player.is_concealed(),"offensive reveal reuses existing cloak state")
