	var pushed := enemy.apply_world_defender_push(Fixture.point("landing",Vector3(220,40,50)),80.0,world.geometry_revision)
	check(pushed["ok"] and enemy.world_point().position.y > 0.0 and enemy.world_point().position.y < 40.0,"real enemy push follows continuous ramp without teleport or 2D fallback")
