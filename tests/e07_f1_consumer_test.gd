	player.set_process(false)
	var destination := Fixture.point("landing",Vector3(220,40,50))
	check(player.use_world_dash(destination,world.geometry_revision),"duration-driven dash accepted")
	player._process(PlayerActor.DASH_DURATION*0.5)
