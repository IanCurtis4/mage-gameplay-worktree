static func surface(id: String, x0: float, x1: float, z0: float, z1: float, y0: float, y1: float) -> ExpeditionSurfaceDefinition:
	var result := ExpeditionSurfaceDefinition.new()
	result.surface_id = id
	result.vertices = PackedVector3Array([Vector3(x0,y0,z0),Vector3(x1,y1,z0),Vector3(x1,y1,z1),Vector3(x0,y0,z1)])
	result.headroom = 100.0
	return result
static func endpoint(id: String, point: Vector3, outward: Vector3) -> ExpeditionConnectorDefinition:
	var result := F0.connector(id, point, outward)
	result.width = 40.0
	result.headroom = 100.0
	return result
static func part(id: String, cell: ExpeditionSurfaceDefinition) -> ExpeditionPartDefinition:
	var result := F0.part(id)
	result.allowed_rotations.assign([0])
	result.surfaces.assign([cell])
	result.connectors.clear()
	return result
