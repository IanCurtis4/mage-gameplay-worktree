	check(trap.bind_world_area(world,origin,profile,world.geometry_revision)["ok"],"real explosive captures surface")
	trap.hit.connect(func(_request: DamageRequest,victim: CombatActor) -> void: hits.append(victim.get_instance_id()))
	hits.clear(); trap._process(0.8)
	check(hits == [lower.get_instance_id()] and trap.state == PlayerTrap.State.TRIGGERED,"real trap selection, one-shot lifecycle and blast share ground query")
	var snare := SnareTrap.new(); root.add_child(snare); owned.append(snare)
	snare.configure_snare(999,Vector2.ZERO,1.0,[upper]); snare.set_process(false)
