	check(lower.attribute_debuffs.fraction(AttributeDebuffState.MOVE_SPEED) > 0.0 and upper.attribute_debuffs.fraction(AttributeDebuffState.MOVE_SPEED) == 0.0,"tar slows actual lower occupants only")
