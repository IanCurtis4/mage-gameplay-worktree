static func point(instance: String, position: Vector3) -> ExpeditionWorldPoint:
	return ExpeditionWorldPoint.create("sample", "sample/"+instance+"/surface/floor", position)
static func sources_current() -> bool:
	var root_path := FileAccess.get_file_as_string("res://source_root.txt")
	var hashes: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://source_hashes.json"))
	if root_path.is_empty() or not hashes is Dictionary: return false
	for file: String in hashes:
		if FileAccess.get_sha256(root_path.path_join(file)) != hashes[file] or FileAccess.get_sha256("res://"+file) != hashes[file]: return false
	return true
