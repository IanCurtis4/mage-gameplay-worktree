	for item: Variant in owned:
		if is_instance_valid(item) and not item.is_queued_for_deletion(): item.queue_free()
	await process_frame
	print("E07 F1 consumers: %d checks, %d failures" % [checks,failures])
	quit(0 if failures == 0 else 1)
func actor(world: WorldGeometry,point: ExpeditionWorldPoint,profile: Dictionary) -> CombatActor:
	var result := CombatActor.new(); root.add_child(result); owned.append(result)
	var build := StatCalculator.calculate({&"vit":10})
	result.setup("f1",Color.WHITE,build)
	check(result.bind_world_geometry(world,point,profile,str(result.get_instance_id()))["ok"],"real body support registered")
	return result
func make_player(nav: ArenaNavigation,identity: StringName,ranks: Dictionary,evolution: StringName = &"") -> PlayerActor:
	var build := BuildSnapshot.new(); build.character_id = "f1_consumer_"+identity; build.base_class_id = identity; build.skill_ranks.assign(ranks); build.evolution_id = evolution
	var result := PlayerActor.new(); result.configure(nav,RunState.from_build("f1_fixture",build)); root.add_child(result); owned.append(result); result.set_process(false)
	return result
