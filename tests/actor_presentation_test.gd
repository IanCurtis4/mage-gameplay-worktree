extends SceneTree
var checks := 0; var failures := 0
func _initialize() -> void: run.call_deferred()
func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures += 1; push_error(label)
func run() -> void:
	var nav := ArenaNavigation.new(); nav.configure(Rect2(0,0,1000,1000),[],0)
	var player := PlayerActor.new(); player.configure(nav,RunState.new(&"mage"))
	var actor := CombatActor.new(); actor.setup("Prova",Color.WHITE,player.stat_breakdown); actor.set_animation_kind(&"gel")
	root.add_child(actor); actor.set_process(false)
	actor._process(0.01); var initial := actor._presentation_key.duplicate(true)
	actor._process(0.01)
	check(actor._presentation_key == initial,"identical visible frame retains draw inputs while clock advances")
	check(is_equal_approx(actor.character_animation.state.idle_time,0.02),"animation clock keeps every tick")
	actor._process(0.25)
	check(actor._presentation_key != initial,"next visible atlas frame invalidates drawing")
	actor.character_animation.state.face(Vector2.LEFT); actor._process(0.001)
	check(actor._presentation_key[0][1],"direction flip invalidates sprite drawing")
	var previous := actor._presentation_key.duplicate(true)
	actor.health.current_hp -= 5; actor._process(0.001)
	check(actor._presentation_key != previous,"health bar changes invalidate drawing")
	previous = actor._presentation_key.duplicate(true); actor.health.heal(3); actor._process(0.001)
	check(actor._presentation_key != previous,"healing updates health bar without damage callback")
	previous = actor._presentation_key.duplicate(true); actor.global_position += Vector2.RIGHT; actor._process(0.001)
	check(actor._presentation_key != previous,"movement updates the contact shadow even within one atlas frame")
	previous = actor._presentation_key.duplicate(true); actor.contact_shadows_enabled = false; actor._process(0.001)
	check(actor._presentation_key != previous,"shadow toggle invalidates drawing")
	actor._animate_action(&"basic_attack",Vector2.RIGHT,0.4)
	actor._process(0.05)
	check(is_equal_approx(actor.character_animation.state.action_remaining,0.35),"attack presentation clocks do not lose ticks")
	actor.apply_electrified(0.1); actor._process(0.15)
	check(not actor.is_electrified(),"status expiration still advances independently of redraw")
	var before_hp := actor.health.current_hp
	actor._process(0.01)
	check(actor.health.current_hp == before_hp,"draw scheduling has no health side effect")
	var animation := actor.character_animation
	animation.set_equipment_visual({"main_hand":&"bow"})
	var bow_key := animation.draw_key()
	animation.set_equipment_visual({"main_hand":&"staff"})
	check(animation.draw_key() != bow_key,"equipment changes invalidate cached commands")
	actor.free(); player.free()
	print("Actor presentation: %d checks, %d failures" % [checks,failures])
	quit(0 if failures == 0 else 1)
