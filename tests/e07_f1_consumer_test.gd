	hits.clear(); vertical._process(0.2)
	check(hits.is_empty() and vertical.is_queued_for_deletion() and is_equal_approx(vertical.world_flight.position.y,34.0),"large time step hits slab before upper body without tunnelling")
	var flight := WorldProjectileMotion.new()
