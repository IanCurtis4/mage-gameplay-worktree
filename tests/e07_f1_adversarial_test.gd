extends SceneTree
const Fixture = preload("res://tests/fixtures/e07/f1/fixture_input.gd")
var checks := 0
var failures := 0
func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures += 1; push_error(label)
func _initialize() -> void:
	if not Fixture.sources_current(): push_error("stale fixture"); quit(1); return
	var nav := ArenaNavigation.new()
	nav.configure(Rect2(0,0,1000,800),[Rect2(200,40,80,500)],20.0)
	var flat := FlatWorldGeometry.new(nav)
	var origin := Vector2(100,100)
	var destination := Vector2(420,100)
	var points := nav.get_path(origin,destination)
	var route := flat.path(flat.world_point(origin),flat.world_point(destination),nav.revision)
	check(route["ok"] and route["data"]["points"].size() == points.size(),"flat adapter preserves legacy route length")
	for index: int in range(points.size()):
		check(route["data"]["points"][index] == flat.world_point(points[index]).to_data(),"flat adapter preserves point %d" % index)
	check(flat.query_attack(flat.world_point(origin),flat.world_point(destination),320.0,true,nav.revision)["data"]["hit"],"flat teleport preserves E06 exception")
	check(not flat.query_attack(flat.world_point(origin),flat.world_point(destination),320.0,false,nav.revision)["data"]["hit"],"flat direct ray remains blocked")
	check(not flat.path(ExpeditionWorldPoint.create(FlatWorldGeometry.STAGE,FlatWorldGeometry.SURFACE,Vector3(100,1,100)),flat.world_point(destination),nav.revision)["ok"],"flat adapter cannot drop height")
	var input := Fixture.make()
	var built := ExpeditionAssembler.build(input)
	if not built["ok"]: push_error(str(built)); quit(1); return
	var world := WorldGeometry.new()
	world.configure(built["data"]["manifest"],"sample")
	var revision := world.geometry_revision
	var profile := input.traversal.to_data()
	var origin_world := Fixture.point("root",Vector3(50,0,50))
	var target := Fixture.point("root",Vector3(80,0,50))
	var seam := Fixture.point("root",Vector3(100,0,50))
	check(world.position_query(seam,profile,revision)["ok"],"actor disk can straddle real connected opening")
	check(not world.position_query(Fixture.point("root",Vector3(100,0,90)),profile,revision)["ok"],"actor disk cannot straddle unrelated edge")
	check(world.set_occupant("actor",origin_world,profile,revision)["ok"],"register protected actor")
	check(not world.insert_obstacle("seal",AABB(Vector3(94,0,0),Vector3(5,100,200)),revision)["ok"] and world.geometry_revision == revision,"reject wall cutting actor off from required authored exit, revision unchanged")
	var route_before := world.path(origin_world,target,profile,revision)
	var mutation: Array = route_before["data"]["points"]
	mutation.clear()
	check(not world.path(origin_world,target,profile,revision)["data"]["points"].is_empty(),"path DTO cannot mutate world")
	var ray := world.query_attack({"geometry_rule_id":&"direct_volume","kind":&"cone","range":100.0,"direction":Vector3.RIGHT,"half_angle":0.3},origin_world,target,revision)
	check(ray["ok"] and ray["data"]["hit"],"3D cone hits forward target")
	ray = world.query_attack({"geometry_rule_id":&"direct_volume","kind":&"cone","range":100.0,"direction":Vector3.LEFT,"half_angle":0.3},origin_world,target,revision)
	check(ray["ok"] and not ray["data"]["hit"],"3D cone rejects rear target")
	ray = world.query_attack({"geometry_rule_id":&"direct_volume","kind":&"line","range":100.0,"direction":Vector3.RIGHT,"half_width":2.0},origin_world,Fixture.point("root",Vector3(80,0,60)),revision)
	check(ray["ok"] and not ray["data"]["hit"],"3D line rejects off-axis target")
	var lower := Fixture.point("root",Vector3(50,0,150))
	var upper := Fixture.point("bridge",Vector3(50,40,150))
	ray = world.query_attack({"geometry_rule_id":&"direct_volume","range":20.0,"source_offset":Vector3(0,50,0),"target_offset":Vector3(0,10,0)},lower,upper,revision)
	check(ray["ok"] and ray["data"]["hit"],"explicit aerial volume queries above slab, no projected coordinates")
	check(not world.query_attack({"geometry_rule_id":&"ground_connected","range":100.0,"traversal":profile,"source_offset":Vector3.UP},lower,upper,revision)["ok"],"ground rule cannot silently become aerial")
	var sweep := world.sweep(Vector3(50,50,150),Vector3(50,0,150),{"radius":1.0,"height":2.0},revision)
	check(sweep["ok"] and sweep["data"]["hit"] and sweep["data"]["normal"] == Vector3.UP,"continuous descending collider reports slab contact normal")
	check(world.query_attack({"geometry_rule_id":&"direct_volume","range":39.0},lower,upper,revision)["data"]["range_ok"] == false,"height alone can place target out of range")
	check(not world.path(origin_world,target,{"radius":2.0,"height":12.0,"connector_kinds":[]},revision)["ok"],"empty connector profile fails explicitly")
	check(not world.query_attack({"geometry_rule_id":3,"range":20.0},origin_world,target,revision)["ok"],"wrong rule type returns error without script failure")
	check(not world.query_attack({"geometry_rule_id":&"direct_volume","range":20.0,"source_offset":"invalid"},origin_world,target,revision)["ok"],"invalid aerial offset returns error")
	var lateral := world.sweep(Vector3(50,30,80),Vector3(50,30,120),profile,revision,&"supporting_slabs")
	check(lateral["ok"] and lateral["data"]["hit"],"teleport body cannot enter slab side while its feet remain below floor height")
	var with_foundation := Fixture.make()
	for part: ExpeditionPartDefinition in with_foundation.parts:
		if part.part_id == "lower": part.solid_volumes.append(AABB(Vector3(0,-4,0),Vector3(100,4,200)))
	var foundation_manifest := ExpeditionAssembler.build(with_foundation)
	check(foundation_manifest["ok"],"F0 accepts solid supporting foundation without schema changes")
	if foundation_manifest["ok"]:
		var foundation_world := WorldGeometry.new()
		foundation_world.configure(foundation_manifest["data"]["manifest"],"sample")
		var teleport := foundation_world.query_attack({"geometry_rule_id":&"teleport_legal","range":200.0,"traversal":profile},origin_world,Fixture.point("slope",Vector3(150,20,50)),foundation_world.geometry_revision)
		check(teleport["ok"] and teleport["data"]["hit"],"teleport may leave solid floor upward without falsely crossing its foundation")
	var visible: Array[String] = [origin_world.surface_id,"sample/slope/surface/floor",upper.surface_id]
	var near_hit := world.resolve_surface(Vector3(50,100,150),Vector3(0.5,-1,-0.5),visible,revision)
	check(near_hit["ok"] and near_hit["data"]["point"]["surface_id"] == upper.surface_id and near_hit["data"]["point"]["position"] == Vector3(80,40,120),"far shared-edge tie cannot hide a unique nearer visible support")
	world.configure(built["data"]["manifest"],"sample")
	check(world.geometry_revision > revision and not world.sweep(Vector3.ZERO,Vector3.ONE,{"radius":1.0,"height":2.0},revision)["ok"],"world replacement invalidates old query revision")
	check(WorldSkillGeometryRules.rule(&"future_skill").is_empty(),"unknown future skill has no silent geometry default")
	print("E07 F1 adversarial/flat: %d checks, %d failures" % [checks,failures])
	quit(0 if failures == 0 else 1)
