	for identity: Array in [[&"swordsman",&""],[&"mage",&""],[&"archer",&""],[&"swordsman",&"defender"],[&"swordsman",&"berserker"],[&"mage",&"elementalist"],[&"mage",&"spiritualist"],[&"archer",&"sentinel"],[&"archer",&"hunter"],[&"mage",&"mg_ar"]]:
