extends SceneTree
const Preferences = preload("res://scripts/map_authoring/library/editor_preferences.gd")
const Library = preload("res://scripts/map_authoring/library/library_model.gd")
const Piece = preload("res://scripts/map_authoring/document/source_document.gd")
const Schema = preload("res://scripts/map_authoring/document/source_schema.gd")
const MapDocument = preload("res://scripts/map_authoring/composition/map_document.gd")
const MapStore = preload("res://scripts/map_authoring/composition/map_store.gd")
const IO = preload("res://scripts/map_authoring/io/source_store.gd")
var checks: Array[Dictionary] = []
func _initialize() -> void: run.call_deferred()
func check(id: String, ok: bool) -> void:
	checks.append({"id":id,"ok":ok}); print("F9_LIBRARY_CHECK "+id+" "+str(ok))
func run() -> void:
	var data := Preferences.empty(); var original := data.duplicate(true)
	check("empty_preferences_valid",Preferences.validate(data))
	var bad := data.duplicate(true); bad.version = true
	check("boolean_version_rejected",not Preferences.validate(bad))
	bad = data.duplicate(true); bad["script"] = "res://untrusted.gd"
	check("unknown_fields_rejected",not Preferences.validate(bad))
	var favorite := Preferences.apply(data,{"operation":"favorite","id":"prop:oak_tree","enabled":true})
	check("favorite_added_without_mutating_input",favorite.ok and favorite.data.favorites == ["prop:oak_tree"] and data == original)
	var repeated := Preferences.apply(favorite.data,{"operation":"favorite","id":"prop:oak_tree","enabled":true})
	check("favorite_is_idempotent",repeated.ok and repeated.hash == favorite.hash)
	check("favorite_removed",Preferences.apply(favorite.data,{"operation":"favorite","id":"prop:oak_tree","enabled":false}).data == data)
	bad = data.duplicate(true); bad.favorites = ["prop:oak_tree","prop:oak_tree"]
	check("duplicate_favorite_rejected",not Preferences.validate(bad))
	check("favorite_unknown_parameter_rejected",not Preferences.apply(data,{"operation":"favorite","id":"prop:oak_tree","enabled":true,"path":"anything"}).ok)
	var presets := Library.builtin_presets(); var options: Dictionary = presets[0].options
	var preset_ids: Array[String] = []; var preset_modes: Array[String] = []
	for preset: Dictionary in presets: preset_ids.append(preset.id); preset_modes.append(preset.options.mode)
	check("builtin_presets_use_existing_brush_options",presets.size() == 4 and preset_ids == ["builtin_soft_hill","builtin_smooth_ground","builtin_earth_path","builtin_rounded_hill"] and preset_modes == ["raise","smooth","material","rounded_hill"] and presets.all(func(p: Dictionary) -> bool: return Preferences.valid_options(p.options)))
	presets[0].options.radius = 3
	presets[3].options.mode = "raise"
	check("builtin_preset_returns_immutable_copy",Library.builtin_presets()[0].options.radius == 120 and Library.builtin_presets()[3].options.mode == "rounded_hill")
	options = Library.builtin_presets()[3].options
	var custom := {"id":"custom_hill","name":"Minha colina","options":options}
	var changed := Preferences.apply(data,{"operation":"preset_save","preset":custom})
	check("custom_preset_roundtrip",changed.ok and Library.preset("custom_hill",changed.data).preset == custom and data == original)
	custom.options.radius = 88
	check("custom_preset_copies_input",changed.data.presets[0].options.radius == 120)
	var updated := Preferences.apply(changed.data,{"operation":"preset_save","preset":custom})
	check("preset_update_preserves_identity",updated.ok and updated.data.presets.size() == 1 and updated.data.presets[0].options.radius == 88)
	check("preset_removed",Preferences.apply(updated.data,{"operation":"preset_remove","id":"custom_hill"}).data == data)
	check("builtin_preset_cannot_be_removed",not Preferences.apply(data,{"operation":"preset_remove","id":"builtin_soft_hill"}).ok)
	custom.options.mode = "execute"
	check("unsupported_brush_mode_rejected",not Preferences.apply(data,{"operation":"preset_save","preset":custom}).ok)
	custom.options = options.duplicate(true); custom.options.radius = NAN
	check("nonfinite_preset_rejected",not Preferences.apply(data,{"operation":"preset_save","preset":custom}).ok)
	custom.options.radius = -1
	check("negative_radius_rejected",not Preferences.apply(data,{"operation":"preset_save","preset":custom}).ok)
	var a := data.duplicate(true); a.favorites = ["prop:oak_tree","material:earth"]; var b := a.duplicate(true); b.favorites.reverse()
	check("preference_hash_ignores_list_order",Preferences.digest(a) == Preferences.digest(b))
	Preferences.install_storage(Callable(),Callable()); var read := Preferences.read()
	check("headless_preferences_roundtrip",Preferences.write(favorite.data,read.hash).ok and Preferences.read().data == favorite.data)
	check("stale_preferences_refuse_write",Preferences.write(data,read.hash).get("code") == "preferences_stale")
	var pieces := Piece.empty("library_piece"); var piece_original := pieces.duplicate(true); var hash := Schema.semantic_hash(pieces)
	check("preferences_do_not_change_source_hash",Preferences.transact({"operation":"favorite","id":"material:earth","enabled":true}).ok and Schema.semantic_hash(pieces) == hash and pieces == piece_original)
	var catalog := Library.entries(Preferences.read().data)
	check("catalog_has_six_props_four_materials_five_borders",catalog.ok and catalog.entries.size() == 15 and catalog.entries.filter(func(e: Dictionary) -> bool: return e.kind == "prop").size() == 6)
	check("portuguese_search_folds_accents",Library.folded("Árvore CONSTRUÇÃO") == "arvore construcao")
	check("category_filter_uses_catalog_category",Library.query(catalog.entries,"","materials",false,[]).size() == 4)
	check("favorite_filter_uses_exact_ids",Library.query(catalog.entries,"","",true,["material:earth"]).size() == 1 and Library.query(catalog.entries,"","",true,["material:earth"])[0].id == "material:earth")
	check("search_combines_all_tokens",Library.query(catalog.entries,"terra material","",false,[]).size() == 1)
	var directory := OS.get_environment("F9_EVIDENCE"); var piece_path := directory.path_join("library_piece.json"); var map_path := directory.path_join("library_map.json")
	IO._write(piece_path,JSON.stringify(pieces,"",true,true).to_utf8_buffer()); IO._write(map_path,JSON.stringify(MapDocument.sample(),"",true,true).to_utf8_buffer())
	var described := Library.describe_source(piece_path)
	check("piece_registration_is_passive_and_hashed",described.ok and described.entry.kind == "piece" and described.entry.source_hash == hash and described.entry.byte_hash == IO.disk_hash(piece_path) and Preferences.valid_source(described.entry))
	var registered := Library.register_source(piece_path)
	check("source_registered_without_mutating_file",registered.ok and Preferences.read().data.sources.size() == 1 and IO.disk_hash(piece_path) == described.entry.byte_hash)
	check("map_kind_detected_by_its_producer",Library.describe_source(map_path).entry.kind == "map")
	check("wrong_kind_and_executable_extension_rejected",not Library.describe_source(map_path,"piece").ok and not Library.describe_source("res://scripts/main.gd").ok)
	var duplicate := Library.duplicate_source(pieces,"piece","library_piece_copy")
	check("piece_copy_has_new_identity_and_revision",duplicate.ok and duplicate.data.document_id == "library_piece_copy" and duplicate.data.revision == 1 and pieces == piece_original)
	check("copy_cannot_reuse_original_identity",not Library.duplicate_source(pieces,"piece",pieces.document_id).ok)
	var removed := Preferences.apply(Preferences.read().data,{"operation":"source_remove","id":registered.entry.id})
	check("forget_source_preserves_original_file",removed.ok and removed.data.sources.is_empty() and FileAccess.file_exists(piece_path) and IO.disk_hash(piece_path) == described.entry.byte_hash)
	bad = data.duplicate(true); bad.sources = [described.entry.duplicate(true)]; bad.sources[0].id = "source:forged"
	check("forged_registry_identity_rejected",not Preferences.validate(bad))
	var loaded_map := MapStore.load_source(map_path)
	check("map_loader_hashes_the_exact_bytes_read",loaded_map.ok and loaded_map.byte_hash == IO.disk_hash(map_path))
	var newer_map := MapDocument.sample(); newer_map.name = "Edição externa"; IO._write(map_path,JSON.stringify(newer_map,"",true,true).to_utf8_buffer()); var newer_hash := IO.disk_hash(map_path)
	var stale_save := MapStore.save_source(map_path,loaded_map.data,loaded_map.byte_hash)
	check("map_external_change_after_read_refuses_overwrite",stale_save.get("code") == "io_conflict" and IO.disk_hash(map_path) == newer_hash)
	var empty_path := directory.path_join("empty_map_draft.json"); var empty_saved := MapStore.save_source(empty_path,MapDocument.empty(),"")
	check("empty_map_draft_can_be_preserved",empty_saved.ok and MapStore.load_source(empty_path).data == MapDocument.empty())
	check("thumbnail_key_binds_source_and_environment",not Library.thumbnail_key("a".repeat(64),"b".repeat(64)).is_empty() and Library.thumbnail_key("a".repeat(64),"b".repeat(64)) != Library.thumbnail_key("a".repeat(64),"c".repeat(64)))
	check("thumbnail_paths_reject_nonhash_keys",Library.thumbnail_path("../escape").is_empty() and Library.thumbnail_key("bad","b".repeat(64)).is_empty())
	var alias: String = piece_path.replace("/","\\") if OS.get_name() == "Windows" else piece_path.get_base_dir().path_join("./"+piece_path.get_file())
	var aliased := Library.describe_source(alias)
	check("path_separator_alias_has_same_canonical_source_identity",aliased.ok and aliased.entry.path == described.entry.path and aliased.entry.id == described.entry.id)
	var legacy: Dictionary = described.entry.duplicate(true); legacy.path = alias; legacy.id = Preferences.source_id(alias)
	var legacy_data := Preferences.empty(); legacy_data.sources = [legacy]; legacy_data.favorites = [legacy.id,"prop:oak_tree"]
	var reconciled := Preferences.apply(legacy_data,{"operation":"source_register","entry":described.entry})
	check("register_reconciles_legacy_path_and_preserves_favorite",reconciled.ok and reconciled.data.sources.size() == 1 and reconciled.data.sources[0] == described.entry and described.entry.id in reconciled.data.favorites and "prop:oak_tree" in reconciled.data.favorites)
	var valid_preferences: Dictionary = Preferences.read().data; var broken_preferences := valid_preferences.duplicate(true); broken_preferences.version = 99; Preferences._memory = broken_preferences.duplicate(true)
	var review := Preferences.recovery_preview()
	check("recovery_preview_preserves_invalid_preferences",review.ok and review.data == valid_preferences and Preferences._memory == broken_preferences)
	check("recovery_rejects_stale_confirmation",Preferences.recover("0".repeat(64)).get("code") == "preferences_stale" and Preferences._memory == broken_preferences)
	var restored := Preferences.recover(review.expected_hash)
	check("recovery_keeps_invalid_backup_and_last_valid_state",restored.ok and restored.data == valid_preferences and Preferences.read().data == valid_preferences and Preferences._memory_backups[restored.backup_id] == broken_preferences)
	var image := Image.create(48,32,false,Image.FORMAT_RGBA8); image.fill(Color(0.2,0.4,0.6,1.0))
	var thumbnail_source := ("library_cache_test/"+directory).sha256_text(); var thumbnail_environment := "e".repeat(64); var package_hash := "f".repeat(64)
	var saved_thumbnail := Library.save_thumbnail(thumbnail_source,thumbnail_environment,package_hash,image)
	var loaded_thumbnail := Library.cached_thumbnail(thumbnail_source,thumbnail_environment)
	check("derived_thumbnail_roundtrip_and_bounded_dimensions",saved_thumbnail.ok and loaded_thumbnail.ok and loaded_thumbnail.image.get_size() == Vector2i(256,192) and loaded_thumbnail.package_hash == package_hash)
	check("changed_environment_cannot_reuse_thumbnail",not Library.cached_thumbnail(thumbnail_source,"d".repeat(64)).ok)
	var image_path := Library.thumbnail_path(saved_thumbnail.key); var png := FileAccess.get_file_as_bytes(image_path); png.append(0); IO._write(image_path,png)
	check("modified_png_is_rejected_before_loading",Library.cached_thumbnail(thumbnail_source,thumbnail_environment).get("code") == "library_thumbnail_invalid")
	Library.save_thumbnail(thumbnail_source,thumbnail_environment,package_hash,image)
	IO._write(image_path+".json",JSON.stringify({"version":1,"script":"res://untrusted.gd"}).to_utf8_buffer())
	check("unknown_thumbnail_stamp_fields_are_rejected",Library.cached_thumbnail(thumbnail_source,thumbnail_environment).get("code") == "library_thumbnail_invalid")
	check("thumbnail_cache_does_not_change_registered_source",IO.disk_hash(piece_path) == described.entry.byte_hash)
	var ok := checks.all(func(entry: Dictionary) -> bool: return entry.ok)
	print("F9_LIBRARY_RESULT "+JSON.stringify({"ok":ok,"count":checks.size(),"checks":checks})); quit(0 if ok else 1)
