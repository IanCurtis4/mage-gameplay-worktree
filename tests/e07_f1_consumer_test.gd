	var push_before := enemy.world_point().to_data()
	check(not enemy.apply_world_defender_push(Fixture.point("bridge",Vector3(50,40,150)),80.0,world.geometry_revision)["ok"] and enemy.world_point().to_data() == push_before,"push refuses a detour around the bridge instead of turning into pursuit")
