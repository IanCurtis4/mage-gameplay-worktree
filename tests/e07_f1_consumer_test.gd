	var hostile := ArrowProjectile.new(); root.add_child(hostile); owned.append(hostile)
	hostile.configure(DamageRequest.new(),shield_player,Vector2(9999,9999),nav); hostile.speed = 1000.0; hostile.set_process(false)
	check(hostile.bind_world_flight(world,origin,Vector3(0,5,0),Vector3.RIGHT,{"radius":1.0,"height":2.0},world.geometry_revision)["ok"],"fixed hostile arrow binds world")
	hostile.hit.connect(func(_request: DamageRequest,_victim: CombatActor) -> void: hits.append(0))
	hits.clear(); hostile._process(0.2)
	check(hits.is_empty() and shield_player.shield_resistance == shield_capacity-1 and hostile.world_flight.position.x < 50.0,"front shield intercepts swept hostile arrow before body exactly once")
	shield_player.clear_shield_stance()
	var barrier := PhantomBarrier.new(); root.add_child(barrier); owned.append(barrier)
	barrier.configure(shield_player,Vector2.RIGHT,[],0.0,2); barrier.set_process(false)
	check(barrier.bind_world_volume(world,Fixture.point("root",Vector3(45,0,150)),profile,AABB(Vector3(40,0,130),Vector3(10,18,40)),world.geometry_revision)["ok"],"phantom barrier binds explicit ground anchor and finite volume")
	var intercepted := ArrowProjectile.new(); root.add_child(intercepted); owned.append(intercepted)
	intercepted.configure(DamageRequest.new(),shield_player,Vector2.ZERO,nav); intercepted.speed = 1000.0; intercepted.set_process(false)
	check(intercepted.bind_world_flight(world,origin,Vector3(0,5,0),Vector3.RIGHT,{"radius":1.0,"height":2.0},world.geometry_revision)["ok"],"hostile barrier probe binds")
	hits.clear(); intercepted.hit.connect(func(_request: DamageRequest,_victim: CombatActor) -> void: hits.append(0)); intercepted._process(0.2)
	check(hits.is_empty() and barrier.remaining_capacity == 1 and is_equal_approx(intercepted.world_flight.position.x,39.0),"barrier claims capacity before body delivery at independent entry oracle")
	var upper_arrow := ArrowProjectile.new(); root.add_child(upper_arrow); owned.append(upper_arrow)
	upper_arrow.configure(DamageRequest.new(),upper,Vector2.ZERO,nav); upper_arrow.speed = 1000.0; upper_arrow.set_process(false)
